# LLM configuration for the agent, RAG chat and overview generator.
# Copy to .env and fill in. .env is the single source of truth: these values
# override any AI_* variables already exported in your shell.
#
# Pick ONE block. The whole block must stay consistent — a base URL from one
# provider with a model name from another causes 400s from /api/overview and
# empty chat streams. Verify your choice with GET /api/health.

# --- Groq (hosted, fast) ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_key_here
AI_MODEL=openai/gpt-oss-120b

# --- LM Studio (local, offline) ---
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_API_KEY=lm-studio
# AI_MODEL=qwen2.5-coder-7b-instruct

# --- DeepSeek (hosted) ---
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=deepseek-chat

# --- Optional fallback provider ---
# Used automatically when the primary returns a rate-limit error, so a spent free
# quota (Groq allows ~200k tokens/day) does not end the session. Any
# OpenAI-compatible endpoint works; local LM Studio is the usual choice.
AI_FALLBACK_BASE_URL=http://127.0.0.1:1234/v1
AI_FALLBACK_API_KEY=lm-studio
AI_FALLBACK_MODEL=qwen2.5-coder-7b-instruct

# Demo tip: with LM Studio, load the model BEFORE the demo or the first chat
# takes 60-90 s to warm up. Verify readiness with GET /api/health.
